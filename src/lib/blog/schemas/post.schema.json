{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GH Blog Post Content",
  "type": "object",
  "required": [
    "slug",
    "category",
    "title",
    "dek",
    "meta",
    "seo",
    "hero",
    "stats",
    "toc",
    "intro",
    "sections",
    "faqs",
    "related"
  ],
  "properties": {
    "slug": {
      "type": "string",
      "description": "URL slug (kebab-case)."
    },
    "category": {
      "type": "string",
      "description": "Eyebrow category label above the H1 (e.g. Education, Guides, Explainers)."
    },
    "title": {
      "type": "string",
      "description": "H1 headline in sentence case."
    },
    "dek": {
      "type": "string",
      "description": "One-sentence subtitle (~20-30 words). Also used as fallback meta description."
    },
    "meta": {
      "type": "object",
      "required": [
        "updated",
        "readMinutes",
        "reviewer"
      ],
      "properties": {
        "updated": {
          "type": "string",
          "description": "e.g. 'May 2026'."
        },
        "readMinutes": {
          "type": "integer",
          "description": "Estimated read time in minutes."
        },
        "reviewer": {
          "type": [
            "string",
            "null"
          ],
          "description": "Optional reviewer/attribution line."
        }
      },
      "additionalProperties": false
    },
    "seo": {
      "type": [
        "object",
        "null"
      ],
      "description": "Optional. Overrides for SEO tags and JSON-LD. Sensible defaults are derived from other fields if omitted.",
      "properties": {
        "metaDescription": {
          "type": [
            "string",
            "null"
          ],
          "description": "Meta description. Defaults to post.dek."
        },
        "canonicalUrl": {
          "type": [
            "string",
            "null"
          ],
          "description": "Absolute canonical URL. If omitted, no canonical tag is emitted."
        },
        "ogImage": {
          "type": [
            "string",
            "null"
          ],
          "description": "Open Graph image URL. Defaults to hero.url."
        },
        "authoredAt": {
          "type": [
            "string",
            "null"
          ],
          "description": "ISO-8601 date the article was first published. Used in JSON-LD Article.datePublished."
        },
        "modifiedAt": {
          "type": [
            "string",
            "null"
          ],
          "description": "ISO-8601 date the article was last modified. Used in JSON-LD Article.dateModified."
        },
        "authorName": {
          "type": [
            "string",
            "null"
          ],
          "description": "Author name for JSON-LD Article.author. Defaults to brand.name."
        },
        "keywords": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          },
          "description": "Optional keyword tags."
        }
      },
      "additionalProperties": false,
      "required": [
        "metaDescription",
        "canonicalUrl",
        "ogImage",
        "authoredAt",
        "modifiedAt",
        "authorName",
        "keywords"
      ]
    },
    "hero": {
      "type": "object",
      "required": [
        "url",
        "alt"
      ],
      "properties": {
        "url": {
          "type": "string"
        },
        "alt": {
          "type": "string",
          "description": "Literal description of the image scene."
        }
      },
      "additionalProperties": false
    },
    "stats": {
      "type": [
        "array",
        "null"
      ],
      "description": "OPTIONAL. If present, must be exactly 4 at-a-glance stat cards. Omit or empty to hide the section.",
      "items": {
        "type": "object",
        "required": [
          "value",
          "label"
        ],
        "properties": {
          "value": {
            "type": "string"
          },
          "label": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "toc": {
      "type": "array",
      "description": "Exactly 3 'In this article' promise bullets. Required.",
      "items": {
        "type": "string"
      }
    },
    "intro": {
      "type": "string",
      "description": "Intro paragraph (~90-120 words). Plain prose, no headings."
    },
    "sections": {
      "type": "array",
      "description": "4-10 H2 body sections.",
      "items": {
        "type": "object",
        "required": [
          "heading",
          "blocks"
        ],
        "properties": {
          "heading": {
            "type": "string"
          },
          "blocks": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "object",
                  "required": [
                    "type",
                    "text"
                  ],
                  "properties": {
                    "type": {
                      "const": "p"
                    },
                    "text": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "required": [
                    "type",
                    "text"
                  ],
                  "properties": {
                    "type": {
                      "const": "h3"
                    },
                    "text": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "required": [
                    "type",
                    "items"
                  ],
                  "properties": {
                    "type": {
                      "const": "ul"
                    },
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  },
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "required": [
                    "type",
                    "items"
                  ],
                  "properties": {
                    "type": {
                      "const": "ol"
                    },
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  },
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "required": [
                    "type",
                    "label",
                    "body"
                  ],
                  "properties": {
                    "type": {
                      "const": "keyTakeaway"
                    },
                    "label": {
                      "type": "string"
                    },
                    "body": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "required": [
                    "type",
                    "label",
                    "links"
                  ],
                  "properties": {
                    "type": {
                      "const": "readNext"
                    },
                    "label": {
                      "type": "string"
                    },
                    "links": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "label",
                          "url"
                        ],
                        "properties": {
                          "label": {
                            "type": "string"
                          },
                          "url": {
                            "type": "string"
                          }
                        },
                        "additionalProperties": false
                      }
                    }
                  },
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "required": [
                    "type",
                    "heading",
                    "body",
                    "linkUrl",
                    "linkLabel"
                  ],
                  "properties": {
                    "type": {
                      "const": "cta"
                    },
                    "heading": {
                      "type": "string"
                    },
                    "body": {
                      "type": "string"
                    },
                    "linkUrl": {
                      "type": "string"
                    },
                    "linkLabel": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                }
              ]
            }
          }
        },
        "additionalProperties": false
      }
    },
    "faqs": {
      "type": "array",
      "description": "3+ FAQ Q&A pairs. Required for FAQPage JSON-LD.",
      "items": {
        "type": "object",
        "required": [
          "q",
          "a"
        ],
        "properties": {
          "q": {
            "type": "string"
          },
          "a": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "related": {
      "type": [
        "array",
        "null"
      ],
      "description": "OPTIONAL. If present, exactly 4 related-post cards. Omit or empty to hide the 'More from the Hub' section (useful when a brand has no other posts yet).",
      "items": {
        "type": "object",
        "required": [
          "title",
          "dek",
          "url",
          "thumbUrl",
          "category"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "dek": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "thumbUrl": {
            "type": [
              "string",
              "null"
            ]
          },
          "category": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
